<h2>Manual override</h2>
<%= form_with url: judges_tournament_catch_manual_override_path(tournament_id: @tournament.id, catch_id: @catch.id), local: true,
              data: { controller: "length-edit tag-field", tag_field_tagged_species_id_value: tagged_species_id } do |f| %>
  <%
    # Seed the unit toggle from the catch's own logged unit (not the viewing
    # judge's preference) so an untouched length round-trips to the same stored
    # value. If we defaulted to current_user.length_unit, a species- or note-only
    # override of a differently-unit'd catch would fail LengthParamParsing's
    # untouched-length guard (it only fires when params[:length_unit] matches the
    # catch's unit), re-snapping length_inches and flipping the unit — silently
    # re-scoring every basket the catch is in. Mirrors catches/_organizer_editor.
    unit = @catch.length_unit
    prefill = unit == "centimeters" ? display_cm(@catch.length_inches, unit) : @catch.length_inches
    step    = 0.25
    species_options = ordered_species.map { |s| [s.name, s.id] }
  %>
  <%= label_tag :species_id, "Species" %>
  <%= select_tag :species_id, options_for_select(species_options, @catch.species_id),
                 data: { action: "change->tag-field#toggle", "tag-field-target": "species" } %>

  <%= label_tag :length, "Override length" %>
  <%= number_field_tag :length, prefill, step: step,
                       data: { "length-edit-target": "input", "length-edit-unit": unit } %>
  <% User::LENGTH_UNITS.each do |u| %>
    <label>
      <%= radio_button_tag :length_unit, u, u == unit, data: { action: "change->length-edit#convertUnit" } %>
      <%= u == "inches" ? "Inches" : "Centimeters" %>
    </label>
  <% end %>

  <%= render "catches/tag_field", catch_record: @catch, label_class: nil, input_class: nil %>

  <% if @tournament.supports_forced_slot? %>
    <%# Forcing a catch into a specific slot only makes sense on slot-based
        formats; the length-derived / every-catch formats derive placement
        themselves, so the fields are hidden and the service rejects them. %>
    <%= label_tag :slot_index, "Force into slot index (optional)" %>
    <%= number_field_tag :slot_index %>

    <%= label_tag :entry_id, "Entry id (optional)" %>
    <%= number_field_tag :entry_id %>
  <% end %>

  <%= label_tag :note %>
  <%= text_area_tag :note %>

  <%= submit_tag "Save override" %>
<% end %>
