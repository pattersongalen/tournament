<div class="mb-6">
  <h1 class="text-3xl font-bold">Edit notice — <%= @foreign_club.name %></h1>
  <p class="text-slate-400 mt-1">Members who already acknowledged today will see your changes tomorrow. To stop the notice early and keep its records, move the last day earlier.</p>
</div>

<%= render "form", club_notice: @notice, memberships: @memberships, selected_user_ids: @selected_user_ids,
           url: admin_club_notice_path(@foreign_club, @notice), method: :patch,
           submit_label: "Save notice", cancel_url: admin_club_notice_path(@foreign_club, @notice) %>
