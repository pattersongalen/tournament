<% if @tournament.persisted? %>
  <%= render "organizers/tournament_entries/section" %>
  <%= render "organizers/tournament_judges/section" %>
  <% if current_user.permanent_organizer_in?(current_club) %>
    <%= render "organizers/tournament_deputies/section" %>
  <% end %>
<% end %>

<%= form_with model: [:organizers, @tournament], local: true, class: "space-y-4",
              data: { controller: "tournament-format" } do |f| %>
  <% if @tournament.errors.any? %>
    <ul class="text-red-300 text-sm bg-red-900/40 border border-red-800 rounded-lg p-3 space-y-1">
      <% @tournament.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
    </ul>
  <% end %>

  <div class="bg-slate-800 rounded-xl p-4 space-y-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :name,
                       class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
    </div>

    <%= render "organizers/shared/format_select", f: f, record: @tournament %>

    <div>
      <%= f.label :mode, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.select :mode, Tournament.modes.keys, {},
                   class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base",
                   data: { tournament_format_target: "mode" } %>
      <p class="text-xs text-slate-500 mt-1 hidden" data-tournament-format-target="modeNote">
        Big Fish Season is solo-only.
      </p>
    </div>

    <div>
      <%= f.label :starts_at, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.datetime_local_field :starts_at,
                                 class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
    </div>

    <div>
      <%= f.label :ends_at, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.datetime_local_field :ends_at,
                                 class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
    </div>

    <div>
      <%= f.label :season_tag, "Season tag", class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :season_tag,
                       class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
    </div>

    <label class="flex items-center gap-3 mt-2">
      <%= f.check_box :requires_release_video, class: "h-5 w-5" %>
      <span class="text-slate-200">Require release video</span>
    </label>
    <p class="text-xs text-slate-500 -mt-2">When off, anglers won't be prompted to record a release video.</p>

    <label class="flex items-center gap-3 mt-2">
      <%= f.check_box :judged, class: "h-5 w-5" %>
      <span class="text-slate-200">Judged tournament</span>
    </label>
    <p class="text-xs text-slate-500 -mt-2">Off = friendly: organizers can disqualify catches and adjust lengths. On: only assigned judges can.</p>

    <label class="flex items-center gap-3 mt-2">
      <%= f.check_box :local, class: "h-5 w-5", data: { tournament_format_target: "localCheckbox" } %>
      <span class="text-slate-200">Local tournament</span>
    </label>
    <p class="text-xs text-slate-500 -mt-2">When on, catches with GPS outside the lake area won't count for this tournament. Off = away/destination tournament; geofence not enforced.</p>

    <label class="flex items-center gap-3 mt-2">
      <%= f.check_box :awards_season_points, class: "h-5 w-5" %>
      <span class="text-slate-200">Awards season points</span>
    </label>
    <p class="text-xs text-slate-500 -mt-2">When on, this tournament contributes to the season points leaderboard (using its season tag). Top finishers earn points based on how many entries (boats or teams) fished.</p>

    <% blind_locked = @tournament.persisted? && @tournament.starts_at && @tournament.starts_at <= Time.current %>
    <% if blind_locked %>
      <%= f.hidden_field :blind_leaderboard, value: @tournament.blind_leaderboard ? "1" : "0" %>
      <label class="flex items-center gap-3 mt-2 opacity-60">
        <input type="checkbox" name="tournament[blind_leaderboard]" disabled <%= "checked" if @tournament.blind_leaderboard %> class="h-5 w-5">
        <span class="text-slate-200">Blind leaderboard</span>
      </label>
    <% else %>
      <label class="flex items-center gap-3 mt-2">
        <%= f.check_box :blind_leaderboard, class: "h-5 w-5", data: { tournament_format_target: "blindCheckbox" } %>
        <span class="text-slate-200">Blind leaderboard</span>
      </label>
    <% end %>
    <p class="text-xs text-slate-500 -mt-2">
      While the tournament is running, only judges can see the full leaderboard.
      Anglers see only their own team's catches; everyone else sees just the entry list.
      The full leaderboard is revealed when the tournament ends.
      <% if blind_locked %><br><strong>Locked once the tournament starts.</strong><% end %>
    </p>

    <label class="flex items-center gap-3 mt-2">
      <%= f.check_box :entrants_only_leaderboard, class: "h-5 w-5" %>
      <span class="text-slate-200">Show leaderboard to entrants only</span>
    </label>
    <p class="text-xs text-slate-500 -mt-2">When on, only members added to this tournament (plus judges and organizers) can open its leaderboard. Other members see the tournament listed but can't click through until the tournament ends — after that, all members can view it.</p>
  </div>

  <div class="bg-slate-800 rounded-xl p-4 space-y-3" data-tournament-format-target="slotsSection">
    <h3 class="text-lg font-semibold" data-tournament-format-target="slotsHeading">Scoring slots</h3>
    <p class="text-sm text-slate-400" data-tournament-format-target="slotsHelp">Pick a species and how many of that fish counts. Blank rows are ignored.</p>

    <%= f.fields_for :scoring_slots do |sf| %>
      <div class="bg-slate-900 rounded-lg p-3 space-y-2 border border-slate-700"
           data-tournament-format-target="slotRow">
        <label class="block text-sm text-slate-400">Species</label>
        <%= sf.collection_select :species_id, ordered_species, :id, :name,
                                 { include_blank: "—" },
                                 class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>

        <label class="block text-sm text-slate-400 mt-2" data-tournament-format-target="slotCountLabel">Slots</label>
        <%= sf.number_field :slot_count, min: 1, value: sf.object.slot_count || 1,
                            class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>

        <% if sf.object.persisted? %>
          <label class="flex items-center gap-2 text-sm text-slate-400 mt-2">
            <%= sf.check_box :_destroy, class: "h-5 w-5" %>
            Remove this slot
          </label>
        <% end %>
      </div>
    <% end %>

    <p class="text-xs text-slate-500 italic">
      Save the tournament for another empty row to appear on the edit page.
    </p>

    <%= render "organizers/shared/fish_train_builder", f: f, record: @tournament, club: current_club %>
  </div>

  <div class="bg-slate-800 rounded-xl p-4 space-y-3 hidden" data-tournament-format-target="rangeSection">
    <h3 class="text-lg font-semibold">Random Bag target range</h3>
    <p class="text-sm text-slate-400">
      Each team gets a random target length (drawn in ¼″ steps) between these bounds when the tournament starts.
      Set min and max to the same number to give every team the identical target.
    </p>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :target_min_inches, "Min (inches)", class: "block text-sm text-slate-400 mb-1" %>
        <%= f.number_field :target_min_inches, step: "0.25", value: (f.object.target_min_inches || 70),
                           class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
      </div>
      <div>
        <%= f.label :target_max_inches, "Max (inches)", class: "block text-sm text-slate-400 mb-1" %>
        <%= f.number_field :target_max_inches, step: "0.25", value: (f.object.target_max_inches || 100),
                           class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base" %>
      </div>
    </div>
  </div>

  <%= f.submit class: "w-full h-14 px-6 text-lg font-semibold rounded-lg bg-blue-600 active:bg-blue-700 text-white" %>
<% end %>

<% if @tournament.persisted? %>
  <%= render "organizers/catches/section" %>
<% end %>
