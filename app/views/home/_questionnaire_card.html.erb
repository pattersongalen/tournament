<section id="questionnaire-card-<%= item[:entry].id %>"
         class="bg-emerald-500/10 border border-emerald-500/40 rounded-xl p-4 my-3">
  <h2 class="text-lg font-semibold text-emerald-100">You placed <%= item[:place].ordinalize %> in <%= item[:tournament].name %></h2>
  <p class="text-slate-300 mb-3">Tell the club what worked.</p>
  <div class="flex gap-2">
    <%= link_to "Answer", edit_tournament_entry_questionnaire_path(item[:tournament], item[:entry]),
          class: "flex-1 h-12 px-4 rounded-lg bg-emerald-600 active:bg-emerald-700 text-white font-semibold text-center leading-[3rem]" %>
    <%= button_to "Not now", tournament_entry_questionnaire_dismissal_path(item[:tournament], item[:entry]),
          method: :post,
          form_class: "flex-1",
          class: "w-full h-12 px-4 rounded-lg bg-slate-700 active:bg-slate-600 text-slate-100" %>
  </div>
</section>
