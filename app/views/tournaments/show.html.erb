<%# Also rendered by Admin::Clubs::TournamentsController#show; @foreign_club suppresses member CTAs. %>
<h1 class="text-2xl font-semibold mt-4 mb-4">
  <%= @tournament.name %>
  <% if @tournament.ended? %>
    <span class="text-xs uppercase tracking-wide text-slate-300 bg-slate-700 rounded px-2 py-1 align-middle ml-2">Completed</span>
  <% end %>
</h1>

<% unless @foreign_club %>
  <% is_judge   = TournamentJudge.exists?(tournament_id: @tournament.id, user_id: current_user.id) %>
  <% is_entered = TournamentEntryMember.joins(:tournament_entry)
                    .exists?(tournament_entries: { tournament_id: @tournament.id }, user_id: current_user.id) %>

  <% if @tournament.ended? %>
    <p class="text-slate-400 mb-4">This tournament has ended.</p>
  <% elsif is_judge %>
    <p class="text-slate-400 mb-4">You're judging this tournament.</p>
  <% elsif is_entered %>
    <% has_teammates = @tournament.mode_team? && Tournaments::TeammatesFor.call(user: current_user, tournament: @tournament).exists? %>
    <%= link_to "Log Catch",
                (has_teammates ? select_teammate_catches_path : select_species_catches_path),
                class: "block w-full h-14 px-6 text-lg font-semibold rounded-lg bg-blue-600 active:bg-blue-700 text-white text-center leading-[3.5rem] mb-4" %>
  <% else %>
    <p class="text-slate-400 italic">You're not entered. Ask an organizer to add you.</p>
  <% end %>
<% end %>

<% if @tournament.ends_at.present? %>
  <section class="bg-slate-800 rounded-xl p-4 mb-4">
    <div class="flex items-baseline justify-between">
      <span class="text-sm uppercase tracking-wide text-slate-400"><%= @tournament.ended? ? "Ended" : "Ends" %></span>
      <span class="text-slate-100"><%= @tournament.ends_at.strftime("%b %d, %Y · %l:%M %p") %></span>
    </div>
  </section>
<% end %>

<% slots = @tournament.scoring_slots.includes(:species).order(:id) %>
<% if slots.any? %>
  <section class="bg-slate-800 rounded-xl p-4 mb-4">
    <h2 class="text-sm uppercase tracking-wide text-slate-400 mb-2">Scoring</h2>
    <ul class="text-slate-100 space-y-1">
      <% if @tournament.format_fish_train? %>
        <li>
          Train:
          <% @tournament.train_cars.each_with_index do |sp_id, idx| %>
            <% sp = @tournament.scoring_slots.find { |s| s.species_id == sp_id }&.species %>
            <%= sp&.name || "?" %><% if idx < @tournament.train_cars.size - 1 %> → <% end %>
          <% end %>
          (<%= @tournament.train_cars.size %> cars)
        </li>
      <% else %>
        <% slots.each do |slot| %>
          <li>
            <% if @tournament.format_biggest_vs_smallest? %>
              Biggest minus smallest <%= slot.species.name.downcase %>
            <% elsif @tournament.format_hidden_length? %>
              Hidden length 12"-22" <%= slot.species.name.downcase %>
            <% elsif @tournament.format_tagged? %>
              Tagged fish raffle
            <% elsif @tournament.format_progressive_length? %>
              Progressive ladder — most up-sizes of <%= slot.species.name.downcase %>
            <% elsif @tournament.format_beat_the_average? %>
              Catch the average <%= slot.species.name.downcase %>
            <% elsif @tournament.format_pro_walleye? %>
              Pro Rules. 3 under, 2 over 55cm.
            <% elsif @tournament.format_smallest_fish? %>
              <%= slot.slot_count == 1 ? "Smallest #{slot.species.name.downcase}" : "Smallest #{slot.slot_count} #{slot.species.name.downcase.pluralize}" %>
            <% elsif @tournament.format_random_bag? %>
              Random bag of <%= slot.species.name.downcase %> — aim for your random target
            <% elsif slot.slot_count == 1 %>
              Largest <%= slot.species.name.downcase %>
            <% else %>
              Top <%= slot.slot_count %> <%= slot.species.name.downcase.pluralize %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
    <% if @entry_count.to_i.positive? %>
      <div class="text-sm text-slate-400 border-t border-slate-700 mt-2 pt-2">
        <% if @tournament.mode_team? %>
          <%= pluralize(@angler_count, "angler") %> across <%= pluralize(@entry_count, "team") %>
        <% else %>
          <%= pluralize(@angler_count, "angler") %>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<div data-controller="stream-refresh" hidden></div>

<% case @viewer_scope.visibility
   when :full %>
  <%= turbo_stream_from "tournament:#{@tournament.id}:leaderboard:full" %>
<% when :own_entry_only %>
  <%= turbo_stream_from "tournament:#{@tournament.id}:leaderboard:entry:#{@viewer_scope.entry_id}" %>
  <%= turbo_stream_from "tournament:#{@tournament.id}:leaderboard:reveal" %>
<% when :entries_only %>
  <%= turbo_stream_from "tournament:#{@tournament.id}:leaderboard:reveal" %>
<% end %>
<% if @tournament.format_bingo? %>
  <% if is_entered && !@tournament.ended? %>
    <%= link_to "Open your card", bingo_card_tournament_path(@tournament),
        class: "block w-full h-14 px-6 text-lg font-semibold rounded-lg bg-emerald-600 active:bg-emerald-700 text-white text-center leading-[3.5rem] mb-4" %>
  <% end %>
  <%= render "tournaments/bingo_leaderboard", leaderboard: @leaderboard, tournament: @tournament %>
<% elsif @tournament.format_tagged? %>
  <%= render "tournaments/tagged_leaderboard",
             tournament: @tournament, leaderboard: @leaderboard, viewer_scope: @viewer_scope %>
<% else %>
  <%= render "tournaments/leaderboard",
             leaderboard: @leaderboard, tournament: @tournament, viewer_scope: @viewer_scope %>
<% end %>
<%# @foreign_club is the site-admin cross-club view: answers show, answer links do not. %>
<%= render "tournaments/what_worked",
           tournament: @tournament,
           items: Questionnaires::WhatWorked.call(
             tournament: @tournament, rows: @leaderboard,
             viewer: current_user, club: (@foreign_club ? nil : current_club)
           ) %>
<%= turbo_frame_tag "catch_photo_modal" %>
