<h1 class="text-2xl font-semibold mt-4 mb-4">Catch</h1>

<div class="bg-slate-800 rounded-xl p-4 space-y-4">
  <% photos = catch_detail_photos(@catch) %>
  <% if photos.any? %>
    <%
      base_filename = [
        @catch.species&.name,
        length_token(@catch.length_inches, @catch.length_unit),
        @catch.captured_at_device&.strftime("%Y-%m-%d %H%M")
      ].compact.join(" - ")
    %>
    <% photos.each do |p| %>
      <% download_filename = "#{[base_filename, p[:label]].compact.join(' - ')}.jpg" %>
      <div>
        <% if p[:label] %>
          <p class="text-xs text-slate-400 mb-1"><%= p[:label] %></p>
        <% end %>
        <div data-controller="photo-save"
             data-photo-save-url-value="<%= photo_download_url(p[:attachment]) %>"
             data-photo-save-filename-value="<%= download_filename %>">
          <%# min-h: reserve space so the Save button and details don't jump
              down when the photo lands over slow lake cellular %>
          <%= thumb p[:attachment], size: [1200, 1200], class: "w-full min-h-64 max-h-96 object-contain rounded-lg bg-black" %>
          <button type="button"
                  data-action="photo-save#save"
                  class="mt-3 h-12 px-4 rounded-lg bg-blue-600 active:bg-blue-700 text-white font-semibold w-full">
            Save photo
          </button>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="w-full h-64 rounded-lg bg-black flex items-center justify-center text-slate-500">no photo</div>
  <% end %>

  <%= render "shared/catch_video", catch_record: @catch,
             video_class: "w-full max-h-96 rounded-lg bg-black" %>

  <dl class="text-slate-300 text-sm space-y-1">
    <div><dt class="inline text-slate-500">Angler:</dt> <dd class="inline text-slate-100"><%= @catch.user.name %></dd></div>
    <% if @catch.logged_by_user %>
      <div><dt class="inline text-slate-500">Logged by:</dt> <dd class="inline text-slate-100"><%= @catch.logged_by_user.name %></dd></div>
    <% end %>
    <div><dt class="inline text-slate-500">Species:</dt> <dd class="inline"><%= @catch.species.name %></dd></div>
    <div><dt class="inline text-slate-500">Length:</dt> <dd class="inline"><%= format_length_dual(@catch.length_inches, @catch.length_unit) %></dd></div>
    <% if @catch.tag_number.present? %>
      <div><dt class="inline text-slate-500">Tag #:</dt> <dd class="inline text-amber-300 font-mono"><%= @catch.tag_number %></dd></div>
    <% end %>
    <% if @catch.weight_text.present? %>
      <div><dt class="inline text-slate-500">Weight:</dt> <dd class="inline text-slate-100"><%= @catch.weight_text %></dd></div>
    <% end %>
    <div><dt class="inline text-slate-500">Captured:</dt> <dd class="inline"><%= @catch.captured_at_device.strftime("%b %d %Y · %l:%M:%S %p %Z") %></dd></div>
    <% if @catch.latitude.present? %>
      <div><dt class="inline text-slate-500">GPS:</dt>
        <% if @catch.user_id == current_user.id %>
          <dd class="inline">
            <%= link_to "#{@catch.latitude.to_f.round(5)}, #{@catch.longitude.to_f.round(5)}",
                        maps_url_for(@catch), target: "_blank", rel: "noopener",
                        class: "text-blue-400 underline" %>
            <span class="text-slate-500 text-xs whitespace-nowrap">· Open in Maps ↗</span>
          </dd>
        <% else %>
          <dd class="inline">~<%= @catch.latitude.to_f.round(2) %>, <%= @catch.longitude.to_f.round(2) %></dd>
        <% end %>
      </div>
    <% end %>
    <div><dt class="inline text-slate-500">Status:</dt>
      <dd class="inline">
        <% if @catch.disqualified? %>
          <span class="text-red-400">disqualified</span>
        <% elsif visible_flags_for(@catch).any? || @catch.latest_approver %>
          <%= render "catches/flag_badges", catch_record: @catch %>
        <% elsif @catch.needs_review? %>
          <span class="text-amber-400">needs review</span>
        <% else %>
          <%= @catch.status %>
        <% end %>
      </dd>
    </div>
  </dl>
</div>

<% if @catch.disqualified? %>
  <div class="bg-slate-800 border border-red-900/40 rounded-xl p-4 mt-3">
    <h2 class="text-sm font-semibold text-red-400 mb-2">Reason for disqualification</h2>
    <% if @catch.disqualification_note.present? %>
      <p class="text-slate-200 whitespace-pre-line"><%= @catch.disqualification_note %></p>
    <% else %>
      <p class="text-slate-500 italic">No reason provided.</p>
    <% end %>
  </div>
<% end %>

<% if @catch.temperature_c.present? || @catch.moon_phase.present? %>
  <div class="bg-slate-800 rounded-xl p-4 mt-3 space-y-1">
    <h2 class="text-sm font-semibold text-slate-400 mb-2">Conditions at catch</h2>
    <dl class="text-slate-300 text-sm space-y-1">
      <% if @catch.temperature_c.present? %>
        <div><dt class="inline text-slate-500">Temp:</dt> <dd class="inline"><%= format_temperature_dual(@catch.temperature_c) %></dd></div>
      <% end %>
      <% if @catch.barometric_pressure_hpa.present? %>
        <div>
          <dt class="inline text-slate-500">Pressure:</dt>
          <dd class="inline"><%= (@catch.barometric_pressure_hpa.to_f / 10).round(1) %> kPa</dd>
          <% trend = format_pressure_trend(@catch.pressure_trend_24h_hpa) %>
          <% if trend %>
            <span class="text-slate-500">(<%= trend %>)</span>
          <% end %>
        </div>
      <% end %>
      <% if @catch.wind_speed_kph.present? %>
        <%
          wind_text = format_wind_dual(@catch.wind_speed_kph)
          compass   = format_wind_compass(@catch.wind_direction_deg)
          wind_text = "#{wind_text} #{compass}" if compass
        %>
        <div><dt class="inline text-slate-500">Wind:</dt> <dd class="inline"><%= wind_text %></dd></div>
      <% end %>
      <% if @catch.moon_phase.present? %>
        <div><dt class="inline text-slate-500">Moon:</dt> <dd class="inline"><%= @catch.moon_phase %></dd></div>
      <% end %>
    </dl>
  </div>
<% elsif @catch.latitude.present? %>
  <div class="bg-slate-800 rounded-xl p-4 mt-3 text-sm text-slate-500">Conditions fetching…</div>
<% end %>

<% if @catch.user_id == current_user.id %>
  <%= form_with model: @catch, method: :patch, local: true,
                class: "bg-slate-800 rounded-xl p-4 mt-3 space-y-2" do |f| %>
    <%= f.label :note, "Notes (private)", class: "block text-sm font-medium text-slate-300" %>
    <%= f.text_area :note, maxlength: 500, rows: 4,
                    class: "w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-base text-slate-100" %>
    <%= f.submit "Save notes",
                 class: "h-12 px-4 rounded-lg bg-blue-600 active:bg-blue-700 text-white font-semibold w-full" %>
  <% end %>
<% end %>

<% if current_user.admin? %>
  <section class="bg-slate-800 rounded-xl p-4 mt-3">
    <h2 class="text-sm uppercase tracking-wide text-slate-400 mb-3">Reference photo</h2>
    <p class="text-xs text-slate-500 mb-3">
      <%= @catch.reference_photo.attached? ? "Replaces the current reference photo for all viewers." : "Shown to everyone alongside the angler's original photo." %>
    </p>
    <%= render "catches/reference_photo_form", catch: @catch %>
  </section>
<% end %>

<% if @action_tournament %>
  <div class="bg-slate-800 rounded-xl p-4 mt-3 space-y-3">
    <h2 class="text-sm font-semibold text-slate-300">Actions</h2>
    <% unless @catch.disqualified? %>
      <% if current_user.id == @catch.user_id %>
        <p class="text-xs text-slate-500">You can't approve your own catch.</p>
      <% elsif @catch.latest_approver.nil? %>
        <%= button_to "Approve",
                      judges_tournament_catch_review_path(tournament_id: @action_tournament.id, catch_id: @catch.id),
                      method: :post,
                      params: { action_kind: "approve" },
                      form: { data: { turbo_confirm: "Approve this catch? It will count for scoring." } },
                      class: "block w-full h-12 px-4 rounded-lg bg-emerald-600 active:bg-emerald-700 text-white font-semibold" %>
      <% end %>
    <% end %>
    <%= form_with url: judges_tournament_catch_review_path(tournament_id: @action_tournament.id, catch_id: @catch.id),
                  local: true, class: "space-y-2",
                  data: { turbo_confirm: "Disqualify this catch? It will be removed from the leaderboard." } do %>
      <%= hidden_field_tag :action_kind, "disqualify" %>
      <label for="dq_note" class="block text-xs text-slate-400">Reason for disqualification (required)</label>
      <%= text_area_tag :note, nil, id: "dq_note", required: true, rows: 2, maxlength: 500,
                        class: "w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-base text-slate-100" %>
      <%= submit_tag "Disqualify",
                     class: "w-full h-12 px-4 rounded-lg bg-red-600 active:bg-red-700 text-white font-semibold" %>
    <% end %>

    <%= form_with url: judges_tournament_catch_manual_override_path(tournament_id: @action_tournament.id, catch_id: @catch.id),
                  local: true, class: "space-y-3",
                  data: { controller: "length-edit tag-field", tag_field_tagged_species_id_value: tagged_species_id } do |f| %>
      <%
        # Seed the unit toggle from the catch's own logged unit (not the viewing
        # judge's preference) so an untouched length round-trips to the same stored
        # value. If we defaulted to current_user.length_unit, a species- or note-only
        # override of a differently-unit'd catch would fail LengthParamParsing's
        # untouched-length guard (it only fires when params[:length_unit] matches the
        # catch's unit), re-snapping length_inches and flipping the unit — silently
        # re-scoring every basket the catch is in. Mirrors catches/_organizer_editor.
        unit = @catch.length_unit
        prefill = unit == "centimeters" ? display_cm(@catch.length_inches, unit) : @catch.length_inches
        step    = 0.25
        species_options = ordered_species.map { |s| [s.name, s.id] }
      %>
      <h3 class="text-sm font-semibold text-slate-300">Edit species &amp; length</h3>

      <label for="species_id" class="block text-xs text-slate-400">Species</label>
      <%= select_tag :species_id,
                     options_for_select(species_options, @catch.species_id),
                     data: { action: "change->tag-field#toggle", "tag-field-target": "species" },
                     class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base text-slate-100" %>

      <label for="length" class="block text-xs text-slate-400">Length</label>
      <%= number_field_tag :length, prefill, step: step, min: 0,
                           inputmode: "decimal",
                           data: { "length-edit-target": "input", "length-edit-unit": unit },
                           class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base text-slate-100" %>
      <%= render "catches/tag_field", catch_record: @catch,
                 label_class: "block text-xs text-slate-400",
                 input_class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700 text-base text-slate-100 font-mono uppercase" %>
      <div class="flex gap-2 items-stretch justify-between">
        <div class="flex rounded-lg overflow-hidden border border-slate-700">
          <% User::LENGTH_UNITS.each do |u| %>
            <label class="cursor-pointer">
              <input type="radio" name="length_unit" value="<%= u %>" <%= "checked" if u == unit %>
                     data-action="change->length-edit#convertUnit"
                     class="sr-only peer">
              <span class="block h-12 px-3 leading-[3rem] text-sm bg-slate-900 peer-checked:bg-blue-600 peer-checked:text-white text-slate-300">
                <%= u == "inches" ? "in" : "cm" %>
              </span>
            </label>
          <% end %>
        </div>
        <%= submit_tag "Save", class: "h-12 px-4 rounded-lg bg-blue-600 active:bg-blue-700 text-white font-semibold" %>
      </div>
    <% end %>
  </div>
<% end %>
