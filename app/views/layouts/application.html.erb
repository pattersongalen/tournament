<!DOCTYPE html>
<html data-app-build="<%= ::AppVersion.current %>">
  <head>
    <title><%= content_for(:title) || ENV.fetch("APP_NAME", "Tournament") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="vapid-public-key" content="<%= VAPID[:public_key] %>">
    <%# Always rendered ("" when signed out) so the mirror below can tell
        "signed out on this layout" apart from "a layout without the meta"
        (admin), where the last-known value must be kept, not cleared. %>
    <meta name="current-user-id" content="<%= current_user&.id %>">
    <script>
      // Mirror the signed-in user into localStorage for the offline queue: the
      // precached /offline shell's current-user-id meta can be stale after an
      // account switch on a shared phone, so offline/current_user.js prefers
      // this mirror over the meta. "" records "signed out". The offline layout
      // must never run this — its cached meta is exactly what can be stale.
      //
      // Turbo Drive only evaluates head scripts that are NEW to the merged
      // head, and this one is byte-identical on every page — so an account
      // switch done entirely through Turbo visits (sign-out button, code
      // form) would never re-run it. The turbo:load listener registered on
      // the initial full load survives every Turbo visit in this window and
      // re-mirrors the (Turbo-updated) meta after each one.
      //
      // EXCEPT restoration visits (Back/edge-swipe): those render a cached
      // snapshot with no server round trip, so the meta in the restored head
      // is whatever user was signed in when the page was cached. Mirroring it
      // would overwrite the mirror with the PREVIOUS user after an account
      // switch — the exact staleness this mirror exists to fix. Track the
      // visit action and skip them.
      //
      // window.__lastTurboVisitAction is written ONLY here and is the shared
      // last-visit-action tracker: stream_refresh_controller reads it too for
      // its restore-visit detection, so this listener must stay registered
      // even if the mirror itself changes.
      (function () {
        var mirror = function () {
          try {
            var cu = document.querySelector("meta[name='current-user-id']");
            if (cu) localStorage.setItem("currentUserId", cu.content);
          } catch (_) {}
        };
        mirror();
        if (!window.__currentUserMirrorBound) {
          window.__currentUserMirrorBound = true;
          document.addEventListener("turbo:visit", function (e) {
            window.__lastTurboVisitAction = e.detail && e.detail.action;
          });
          document.addEventListener("turbo:load", function () {
            if (window.__lastTurboVisitAction === "restore") return;
            mirror();
          });
        }
      })();
    </script>

    <%= yield :head %>
    <%= render "shared/turbo_snapshot_cache_meta" %>

    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0f172a">
    <link rel="apple-touch-icon" href="/icons/icon-180.png">

    <link rel="icon" href="/icons/icon-192.png" type="image/png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= render "shared/leaflet_head" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-900 text-slate-100 min-h-screen">
    <script>
      // Mirror the build the browser actually ran into a cookie so the server can
      // detect a stale PWA shell (a cached shell carries an old data-app-build).
      document.cookie = "app_build=" + encodeURIComponent(document.documentElement.dataset.appBuild || "") + "; path=/; max-age=31536000; samesite=lax";
    </script>
    <%= render "shared/ios_install_coach" %>
    <%= render "shared/sync_auth_notice" %>
    <%= render "shared/notice_popup", club_notice: due_notice if due_notice %>

    <% flash.each do |type, message| %>
      <% styles = case type.to_s
                  when "notice" then "bg-emerald-500/20 border-emerald-500/40 text-emerald-200"
                  when "alert"  then "bg-red-500/20 border-red-500/40 text-red-200"
                  else               "bg-yellow-500/20 border-yellow-500/40 text-yellow-200"
                  end %>
      <p id="flash_<%= type %>" class="<%= styles %> border rounded-lg px-3 py-2 my-2 mx-4"><%= message %></p>
    <% end %>
    <div id="catch-sync-toast"
         data-controller="catch-sync-toast"
         class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white px-4 py-2 rounded-full shadow-lg text-sm font-medium transition-opacity duration-300">
      ✓ Catch synced
    </div>

    <main class="max-w-md mx-auto px-4 pb-24">
      <%= yield %>
    </main>

    <% if signed_in? %>
      <nav data-controller="keyboard-nav"
           class="fixed bottom-0 inset-x-0 max-w-md mx-auto bg-slate-800/95 backdrop-blur border-t border-slate-700 flex pb-[env(safe-area-inset-bottom)]">
        <%= link_to root_path, "aria-label": "Home",
                    class: "flex-1 flex items-center justify-center h-16 active:bg-slate-700" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-slate-100" aria-hidden="true">
            <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.69-8.69a2.25 2.25 0 00-3.18 0l-8.69 8.69a.75.75 0 101.06 1.06l8.69-8.69z" />
            <path d="M12 5.43l7.5 7.5v6.32a2.25 2.25 0 01-2.25 2.25H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H6.75A2.25 2.25 0 014.5 19.5v-6.32l7.5-7.5z" />
          </svg>
        <% end %>
        <button type="button"
                data-controller="app-refresh"
                data-action="app-refresh#reload"
                aria-label="Refresh"
                class="flex-1 flex items-center justify-center h-16 active:bg-slate-700 border-l border-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="w-8 h-8 text-slate-100" aria-hidden="true">
            <path d="M3 12a9 9 0 0 1 15.5-6.4L21 8" />
            <path d="M21 3v5h-5" />
            <path d="M21 12a9 9 0 0 1-15.5 6.4L3 16" />
            <path d="M3 21v-5h5" />
          </svg>
        </button>
      </nav>
    <% end %>
  </body>
</html>
