#!/usr/bin/env bash
# Pull latest on the current branch and bring the docker stack up to date.
# Run from anywhere — switches to the repo root automatically.
set -euo pipefail

cd "$(dirname "$0")/.."

# The web container regenerates these tracked files on every boot
# (tailwindcss:build rewrites the CSS bundle, db:migrate rewrites schema.rb),
# so the checkout here is always dirty. Pulling with --autostash used to
# carry them across the pull and pop them back on top, which conflicts
# whenever main also changed one and leaves unmerged index entries that
# block every later pull ("Pulling is not possible because you have
# unmerged files" -- hit 2026-08-13 and 2026-09-25). They are build
# outputs, not edits: put them back to HEAD so the pull is clean and let
# the container regenerate them from the new code. Restoring also clears
# a conflict a previous failed run left on these paths.
echo "==> Discarding container-regenerated build artifacts..."
git restore --source=HEAD --staged --worktree app/assets/builds/tailwind.css db/schema.rb

# A previous failed pull leaves its autostash entry behind. Drop each one
# that holds nothing but those regenerated files; anything else is a hand
# edit somebody made on this box, so it is left in place and named.
# Highest index first: dropping renumbers the entries below it.
for ref in $(git stash list --format=%gd | tac); do
  if git stash show --name-only "$ref" | grep -qvE '^(app/assets/builds/tailwind\.css|db/schema\.rb)$'; then
    echo "!!  $ref holds edits beyond build artifacts; leaving it:"
    git stash show --name-only "$ref" | sed 's/^/      /'
  else
    git stash drop -q "$ref"
  fi
done

echo "==> Pulling latest..."
git pull --ff-only --autostash

echo "==> Clearing any stale Puma pid file..."
rm -f tmp/pids/server.pid

echo "==> Building web image (no-op if Dockerfile/Gemfile haven't changed)..."
docker compose build web

echo "==> Running any pending migrations..."
docker compose run --rm web bin/rails db:migrate

echo "==> Backfilling any catches missing conditions..."
docker compose run --rm web bin/rails catches:backfill_conditions

echo "==> Backfilling any catches missing flags..."
docker compose run --rm web bin/rails catches:backfill_flags

echo "==> Regenerating PWA icons if the source changed..."
docker compose run --rm web bin/rails icons:generate

echo "==> Recreating containers..."
docker compose up -d

# `up -d` only recreates a container when its image or compose config
# changed -- a plain code pull leaves the already-running web container as
# is, so Puma keeps serving the routes and initializers it loaded at boot.
# Restart it explicitly so freshly pulled routes/initializers (e.g. new
# config/initializers/*) are actually loaded.
echo "==> Restarting web so freshly pulled code is loaded..."
docker compose restart web

echo
echo "==> Done. Tailing web logs (Ctrl-C to exit)..."
docker compose logs -f --tail=20 web
